{
  "name": "app-growth-console",
  "version": "1.0.0",
  "description": "Apple Ads, App Store Connect listings, and download analytics dashboard",
  "main": "next.config.mjs",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "dev:turbo": "NODE_OPTIONS=--max-old-space-size=4096 next dev --turbopack",
    "dev:stable": "next build && next start",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "extract-public-key": "node scripts/extractPublicKey.js",
    "generate-test-keys": "node scripts/generateKeyPair.js",
    "build-ppp-template": "node scripts/buildPppTemplate.js"
  },
  "keywords": [
    "apple-search-ads",
    "apple-ads",
    "api-client",
    "advertising"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@google/genai": "^1.52.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "tailwindcss": "^4.2.1"
  }
}
